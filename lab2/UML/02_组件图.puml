@startuml
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor #475569
skinparam classBackgroundColor #EFF6FF
skinparam classBorderColor #64748B
skinparam componentBackgroundColor #EFF6FF
skinparam componentBorderColor #64748B
skinparam stateBackgroundColor #EFF6FF
skinparam stateBorderColor #64748B
skinparam noteBackgroundColor #FFF7DB
skinparam noteBorderColor #D6BD72
skinparam roundcorner 8
skinparam dpi 160
title 组件图 分层架构及模块交互
top to bottom direction
actor "访客 / 普通用户 / 管理员" as Actor
[Web UI\n商品、预约、管理后台] as UI
[应用入口\n当前会话鉴权 / 对象归属 / 命令与查询分流] as Entry
package "业务模块  M01～M07" as Modules {
  [M01 身份与授权] as Auth
  [M03 商品查询] as Search
  [M06 统计查询] as Stats
  [M07 日志与历史] as Audit
  [命令协调器\n请求标识 / 事务边界] as Cmd
  [M02 商品发布与管理] as Item
  [M04 预约与交易] as Trade
  [M05 审核与违规] as Mod
  Auth -[hidden]right- Search
  Search -[hidden]right- Stats
  Stats -[hidden]right- Audit
  Item -[hidden]right- Trade
  Trade -[hidden]right- Mod
  Cmd --> Auth : 命令重验权限
  Cmd --> Item : 草稿、提交、下架
  Cmd --> Trade : 预约、取消、完成
  Cmd --> Mod : 审核与违规
  Trade --> Item : 状态联动
  Mod --> Trade : 终止有效预约
}
[仓储与事务适配器\n模块共用；领域模型约束] as Repo
database "关系数据库\n业务对象、私有联系、快照\n请求回执、审核历史、成功日志" as DB
[独立失败日志写入器] as Fail
artifact "本地故障日志" as File
Actor --> UI
UI --> Entry
Entry --> Auth : 账号
Entry --> Search : 查询
Entry --> Stats : 统计
Entry --> Audit : 历史 / 日志
Entry --> Cmd : 变更命令
Modules --> Repo : 各模块经仓储访问持久化
Repo --> DB : 成功业务同事务提交
Cmd --> Fail : 拒绝或回滚后独立留痕
Fail --> DB : 可用时独立写入
Fail --> File : 数据库不可用
File ..> Audit : 恢复后补录、去重
note bottom of DB
  模块化单体：避免分布式事务，适合课程原型。
  当前状态条件更新 + 唯一有效预约约束避免并发双成功。
  请求回执只存结果引用，重发仍按当前权限裁剪联系。
end note
@enduml
